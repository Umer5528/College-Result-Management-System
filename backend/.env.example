# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/college_result_system

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Seed / default demo credentials (used ONLY by seed script)
SEED_SUPERADMIN_EMAIL=superadmin@college.com
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_ADMIN_EMAIL=admin@college.com
SEED_ADMIN_PASSWORD=Admin@123

# Submission link base (used to build shareable URLs, optional)
PUBLIC_SUBMIT_BASE_URL=http://localhost:5173/submit-result
